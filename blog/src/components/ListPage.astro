---
import BlogLayout from '../layouts/BlogLayout.astro';
import { type Post, type Category, coverOf, titleHtml, SITE, absolute, artFor, artSrc, authorOf, baseGraph, categoryOf, categoryUrl, formatDate, listUrl, postUrl, posts as allPosts, usedCategories, CATEGORY_INDEX_MIN } from '../lib/data';
import { imageAttrs } from '../lib/images';
import { readingMinutesOf } from '../lib/render';
interface Props { posts: Post[]; page: number; pages: number; total: number; category?: Category }
const { posts, page, pages, total, category } = Astro.props;
const url = (n: number) => (category ? categoryUrl(category, n) : listUrl(n));
const path = url(page);
const intro = category?.description || 'Weboldalak, SEO, webanalitika és AI. Gyakorlati útmutatók, konkrét példák és mérések.';
const pageSuffix = page > 1 ? ` – ${page}. oldal` : '';
const title = category ? `${category.name}${pageSuffix} | Vizitor blog` : `Blog${pageSuffix} – weboldal, SEO, marketing | Vizitor`;
// Each category page needs its own description, even when the editor left it empty.
const description = (category ? (category.description || `${category.name}: gyakorlati írások a Vizitor blogján weboldalakról, marketingről és működésről, vállalkozásoknak.`) : intro).slice(0, 160);
const index = !category || total >= CATEGORY_INDEX_MIN;
const crumbs = [{ name: 'Főoldal', url: '/' }, { name: 'Blog', url: '/blog/' }, ...(category ? [{ name: category.name, url: categoryUrl(category) }] : [])];
const editorPick = !category && posts.find(post => post.slug === 'mennyibe-kerul-egy-ceges-weboldal');
const feature = page === 1 ? (editorPick || posts[0]) : undefined;
const rest = posts.filter(post => post !== feature);
const ordered = feature ? [feature, ...rest] : rest;
const featureCover = feature ? coverOf(feature) : undefined;
// A small search index of every published post, so search works across pages and categories.
const searchIndex = allPosts.map(p => ({ t: p.title, e: p.excerpt, c: categoryOf(p).name, u: postUrl(p), d: formatDate(p.publishedAt), m: readingMinutesOf(p) }));
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  ...baseGraph,
  { '@type': category ? 'CollectionPage' : 'Blog', '@id': absolute(path) + '#page', url: absolute(path), name: title, description, inLanguage: 'hu-HU', isPartOf: { '@id': SITE + '/#website' }, publisher: { '@id': SITE + '/#vizitor' } },
  { '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: absolute(c.url) })) },
  { '@type': 'ItemList', itemListElement: ordered.map((p, i) => ({ '@type': 'ListItem', position: (page - 1) * 12 + i + 1, url: absolute(postUrl(p)), name: p.title })) },
] };
---
<BlogLayout title={title} description={description} path={path} jsonLd={jsonLd} index={index} prev={page > 1 ? url(page - 1) : undefined} next={page < pages ? url(page + 1) : undefined} mainClass="archive-main blog-index">
  <section class:list={['bl-hero', { 'bl-hero-overlap': !!feature }]}>
    <div class="wrap">
      <nav class="blog-masthead-trail" aria-label="Morzsamenü">
        {crumbs.map((c, i) => i < crumbs.length - 1 || page > 1 ? <><a href={c.url}>{c.name}</a><span aria-hidden="true">/</span></> : <span aria-current="page">{c.name}</span>)}
        {page > 1 && <span aria-current="page">{page}. oldal</span>}
      </nav>
      <div class="bl-hero-grid">
        <div class="bl-hero-copy">
          <p class="bl-kicker">{category ? 'Téma' : 'Web a gyakorlatban'}</p>
          <h1>{category?.name || 'Vizitor blog'}</h1>
          <p class="bl-deck">{category && !category.description ? `Ebben a témában ${total} írás olvasható. Keress rá bármire, vagy válts témát a szűrővel.` : intro}</p>
        </div>
        <form class="bl-search" role="search" action="/blog/" method="get" data-blog-search>
          <label class="sr-only" for="bl-q">Keresés a cikkek között</label>
          <svg class="bl-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <input id="bl-q" name="q" type="search" placeholder="Keresés: árak, GA4, chatbot…" autocomplete="off" enterkeyhint="search" />
          <kbd aria-hidden="true">/</kbd>
        </form>
        {usedCategories.length > 1 && (
          <button class:list={['bl-filter-toggle', { 'is-filtered': !!category }]} type="button" aria-expanded="true" aria-controls="bl-filters" data-filter-toggle title={category ? `Téma: ${category.name}` : 'Témák'}>
            <span class="sr-only">{category ? `Témák szűrése (most: ${category.name})` : 'Témák szűrése'}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
          </button>
        )}
      </div>
      {usedCategories.length > 1 && (
        <div class="bl-filter-panel" id="bl-filters" data-filter-panel>
        <div class="bl-filter-inner">
        <nav class="bl-chips" aria-label="Témák">
          <a href="/blog/" aria-current={!category ? 'page' : undefined}>Minden<span>{allPosts.length}</span></a>
          {usedCategories.map(({ category: c, posts: list }) => <a href={categoryUrl(c)} aria-current={category && c.id === category.id ? 'page' : undefined}>{c.name}<span>{list.length}</span></a>)}
          <a class="bl-rss-icon" href="/blog/rss.xml" aria-label="Új írások RSS-csatornán" title="RSS"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="6" cy="18" r="2"/><path d="M4 10.5a9.5 9.5 0 0 1 9.5 9.5h-2.4A7.1 7.1 0 0 0 4 12.9v-2.4Zm0-5.5a15 15 0 0 1 15 15h-2.4A12.6 12.6 0 0 0 4 7.4V5Z"/></svg></a>
        </nav>
        </div>
        </div>
      )}
    </div>
  </section>

  <div class="privacy-paper blog-paper bl-paper">
    <div class="wrap">
      <div class="bl-results" data-blog-results hidden></div>
      <p class="sr-only" aria-live="polite" data-blog-status></p>

      <div data-blog-default>
        {feature && (
          <article class="bl-feature">
            <a class="bl-feature-visual" href={postUrl(feature)} tabindex="-1" aria-hidden="true">
              {featureCover
                ? <Fragment set:html={`<img ${imageAttrs(featureCover, { sizes: '(min-width: 1100px) 700px, calc(100vw - 32px)', eager: true })}>`} />
                : <img src={artSrc(artFor(feature))} alt="" width="410" height="236" fetchpriority="high" decoding="async" />}
            </a>
            <div class="bl-feature-copy">
              <p class="bl-eyebrow">{editorPick ? 'Ajánlott' : 'Legfrissebb'} · {categoryOf(feature).name}</p>
              <h2><a href={postUrl(feature)} set:html={titleHtml(feature.title)} /></h2>
              <p class="bl-feature-excerpt">{feature.excerpt}</p>
              <p class="bl-meta">{authorOf(feature).name} · <time datetime={feature.publishedAt}>{formatDate(feature.publishedAt)}</time> · {readingMinutesOf(feature)} perc olvasás</p>
            </div>
          </article>
        )}

        {rest.length > 0 && (
          <>
            <h2 class="bl-section-title">{feature ? 'További írások' : 'Írások'}</h2>
            <div class="bl-grid">
              {rest.map(p => {
                const c = coverOf(p);
                return (
                  <article class="bl-card">
                    <a class="bl-card-visual" href={postUrl(p)} tabindex="-1" aria-hidden="true">
                      {c ? <Fragment set:html={`<img ${imageAttrs(c, { sizes: '(min-width: 1100px) 400px, (min-width: 700px) 46vw, calc(100vw - 32px)', eager: false })}>`} /> : <img src={artSrc(artFor(p))} alt="" width="410" height="236" loading="lazy" decoding="async" />}
                    </a>
                    <div class="bl-card-copy">
                      <p class="bl-eyebrow">{categoryOf(p).name}</p>
                      <h3><a href={postUrl(p)} set:html={titleHtml(p.title)} /></h3>
                      <p class="bl-card-excerpt">{p.excerpt}</p>
                      <p class="bl-meta"><time datetime={p.publishedAt}>{formatDate(p.publishedAt)}</time> · {readingMinutesOf(p)} perc</p>
                    </div>
                  </article>
                );
              })}
            </div>
          </>
        )}

        {pages > 1 && (
          <nav class="blog-pagination bl-pagination" aria-label="Lapozás">
            {page > 1 ? <a rel="prev" href={url(page - 1)}>← Újabb írások</a> : <span></span>}
            <span class="blog-pagination-status">{page} / {pages}</span>
            {page < pages ? <a rel="next" href={url(page + 1)}>Korábbi írások →</a> : <span></span>}
          </nav>
        )}
      </div>

    </div>
  </div>

  <aside class="blog-article-cta" aria-labelledby="cta-title">
    <div class="wrap blog-article-cta-inner">
      <p class="eyebrow">Beszéljük meg</p>
      <h2 id="cta-title">Saját weboldalon gondolkodsz?</h2>
      <p class="blog-article-cta-text">Írd meg röviden, mire van szükséged. Közvetlenül velem egyeztetsz, és még a munka előtt tudni fogod a díjat és a határidőt.</p>
      <div class="blog-article-cta-actions"><a class="button orange" href="/kapcsolat/">Ajánlatot kérek</a></div>
    </div>
  </aside>
  <script type="application/json" id="blog-search-index" set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')} />
</BlogLayout>
