---
// Same anatomy as the site's project cards (/munkak/): tinted tile + framed visual, then meta, title, excerpt.
import { type Post, ARTBG, titleHtml, artFor, artSrc, categoryOf, formatDate, mediaOf, postUrl, tone } from '../lib/data';
import { imageAttrs } from '../lib/images';
interface Props { post: Post; eager?: boolean; headingLevel?: 2 | 3 }
const { post, eager = false, headingLevel = 2 } = Astro.props;
const cover = mediaOf(post.coverImage);
const art = artFor(post);
const Heading = `h${headingLevel}`;
---
<article class="project blog-card">
  <a class="project-visual blog-card-visual" href={postUrl(post)} style={`background:${cover ? tone[art] : ARTBG}`} tabindex="-1" aria-hidden="true">
    {cover
      ? <span class="blog-card-frame"><Fragment set:html={`<img ${imageAttrs(cover, { sizes: '(min-width: 1100px) 560px, (min-width: 700px) 45vw, calc(100vw - 48px)', eager })}>`} /></span>
      : <img class="blog-card-art" src={artSrc(art)} alt="" width="410" height="236" loading={eager ? 'eager' : 'lazy'} decoding="async" />}
    <span class="project-hover">Elolvasom</span>
  </a>
  <div class="project-info">
    <p class="project-category">{categoryOf(post).name} · <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time></p>
    <Heading><a href={postUrl(post)} set:html={titleHtml(post.title)} /></Heading>
  </div>
  <p class="project-description">{post.excerpt}</p>
</article>
