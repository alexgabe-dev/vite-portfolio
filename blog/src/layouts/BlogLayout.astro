---
import { chrome, indexable, absolute, socialOrigin } from '../lib/data';
import '../styles/blog.css';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: unknown;
  index?: boolean;
  prev?: string;
  next?: string;
  article?: { published: string; modified?: string | null; section: string; author: string };
  /** Above-the-fold image to preload (the LCP candidate). */
  preload?: { srcset: string; sizes: string; href: string };
}
const { title, description, path, image = '/og/vizitor-share-2026.png', imageAlt = 'Vizitor — Weboldal. Rád tervezve.', type = 'website', jsonLd, index = true, prev, next, article, preload } = Astro.props;
const canonical = absolute(path);
const socialImage = new URL(image, socialOrigin).href;
const robots = indexable && index ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' : 'noindex, follow';
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---
<!doctype html>
<html lang="hu" data-vizitor-section="blog">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Fragment set:html={chrome.headScript} />
<meta name="theme-color" content="#0c0e11" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
{prev && <link rel="prev" href={absolute(prev)} />}
{next && <link rel="next" href={absolute(next)} />}
<link rel="alternate" type="application/rss+xml" title="Vizitor blog" href="/blog/rss.xml" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Vizitor" />
<meta property="og:locale" content="hu_HU" />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{article && <meta property="article:published_time" content={article.published} />}
{article?.modified && <meta property="article:modified_time" content={article.modified} />}
{article && <meta property="article:section" content={article.section} />}
{article && <meta property="article:author" content={article.author} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={imageAlt} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<Fragment set:html={chrome.fontPreload} />
{preload && <link rel="preload" as="image" href={preload.href} imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
<link rel="stylesheet" href={chrome.stylesheet} />
{ld && <script type="application/ld+json" set:html={ld} />}
</head>
<body>
<a href="#main" class="skip-link">Ugrás a tartalomhoz</a>
<Fragment set:html={chrome.header} />
<main id="main" class="blog-main"><slot /></main>
<Fragment set:html={chrome.footer} />
<Fragment set:html={chrome.consent} />
<script>
  import '../scripts/site-chrome';
</script>
</body>
</html>
