---
import ListPage from '../../../../components/ListPage.astro';
import { usedCategories, paginate } from '../../../../lib/data';
export function getStaticPaths() {
  return usedCategories.flatMap(({ category, posts }) => paginate(posts).filter(p => p.page > 1)
    .map(p => ({ params: { category: category.slug, page: String(p.page) }, props: { category, total: posts.length, ...p } })));
}
const { category, items, page, pages, total } = Astro.props;
---
<ListPage posts={items} page={page} pages={pages} total={total} category={category} />
