---
import ListPage from '../../components/ListPage.astro';
import { posts, paginate } from '../../lib/data';
export function getStaticPaths() {
  return paginate(posts).filter(p => p.page > 1).map(p => ({ params: { page: String(p.page) }, props: p }));
}
const { items, page, pages } = Astro.props;
---
<ListPage posts={items} page={page} pages={pages} total={posts.length} />
