---
import BlogLayout from '../layouts/BlogLayout.astro';
import { type Post, SITE, absolute, coverOf, titleHtml, serviceFor, artFor, artSrc, authorOf, baseGraph, categoryOf, categoryUrl, formatDate, mediaOf, modifiedAt, posts, postUrl, relatedTo, serviceLabels } from '../lib/data';
import { renderPost } from '../lib/render';
import { imageAttrs } from '../lib/images';

export function getStaticPaths() {
  const live = posts.map(post => ({ params: { slug: post.slug }, props: { post, redirectTo: undefined as string | undefined } }));
  // Former slugs of a published article keep working (see docs/BLOG-CMS.md: redirects).
  const moved = posts.flatMap(post => post.previousSlugs.map(slug => ({ params: { slug }, props: { post, redirectTo: postUrl(post) } })));
  return [...live, ...moved];
}
const { post, redirectTo } = Astro.props as { post: Post; redirectTo?: string };
const target = redirectTo ? absolute(redirectTo) : '';
const author = authorOf(post);
const category = categoryOf(post);
const cover = coverOf(post);
const share = mediaOf(post.shareImage) || cover;
const photo = mediaOf(author.photo);
const art = artFor(post);
const modified = modifiedAt(post);
const rendered = redirectTo ? null : await renderPost(post);
const related = relatedTo(post);
const service = post.services.find(s => serviceLabels[s]);
const path = postUrl(post);
const shareUrl = encodeURIComponent(absolute(path));
const baseTitle = (post.metaTitle || post.title).trim();
const title = /(?:vizitor\.hu|vizitor blog|\| vizitor)$/i.test(baseTitle) ? baseTitle : `${baseTitle} | vizitor.hu`;
const description = post.metaDescription || post.excerpt;
const coverSizes = '(min-width: 1392px) 550px, (min-width: 1101px) 39vw, (min-width: 721px) 40vw, (min-width: 601px) calc(100vw - 48px), calc(100vw - 40px)';
const preload = cover ? { href: (cover.variants.find(v => v.width >= 800) || cover.variants[cover.variants.length - 1]).src, srcset: cover.variants.map(v => `${v.src} ${v.width}w`).join(', '), sizes: coverSizes } : undefined;
const hasToc = (rendered?.toc.length || 0) >= 2;
const sideService = serviceFor(post);
const authorNode = { '@type': 'Person', '@id': SITE + '/blog/#author-' + author.slug, name: author.name, ...(author.jobTitle ? { jobTitle: author.jobTitle } : {}), ...(author.sameAs.length ? { sameAs: author.sameAs } : {}), worksFor: { '@id': SITE + '/#vizitor' } };
const jsonLd = rendered && { '@context': 'https://schema.org', '@graph': [
  ...baseGraph,
  {
    '@type': 'BlogPosting', '@id': absolute(path) + '#article', mainEntityOfPage: absolute(path), url: absolute(path),
    headline: post.title, description, inLanguage: 'hu-HU', datePublished: post.publishedAt, dateModified: modified || post.publishedAt,
    author: authorNode, publisher: { '@id': SITE + '/#vizitor' }, isPartOf: { '@id': SITE + '/#website' },
    articleSection: category.name, wordCount: rendered.words,
    ...(share ? { image: [absolute(share.og), ...(cover ? [absolute(cover.variants[cover.variants.length - 1].src)] : [])] } : {}),
    ...(post.sources.length ? { citation: post.sources.map(s => ({ '@type': 'CreativeWork', name: s.title, url: s.url, ...(s.publisher ? { publisher: s.publisher } : {}) })) } : {}),
  },
  { '@type': 'BreadcrumbList', itemListElement: [['Főoldal', '/'], ['Blog', '/blog/'], [category.name, categoryUrl(category)], [post.title, path]].map(([name, url], i) => ({ '@type': 'ListItem', position: i + 1, name, item: absolute(url) })) },
] };
---
{redirectTo ? (
  <html lang="hu"><head><meta charset="utf-8" /><title>Átirányítás: {post.title}</title><meta name="robots" content="noindex, follow" /><link rel="canonical" href={target} /><meta http-equiv="refresh" content={`0; url=${redirectTo}`} /></head>
  <body><p>A cikk új címe: <a href={redirectTo}>{post.title}</a></p></body></html>
) : (
<BlogLayout title={title} description={description} path={path} type="article" image={share?.og} imageAlt={share?.alt || post.title} jsonLd={jsonLd}
  article={{ published: post.publishedAt, modified, section: category.name, author: author.name }} preload={preload} mainClass="service-page blog-post">
  <article aria-labelledby="post-title">
    <header class="wrap blog-masthead">
      <nav class="blog-masthead-trail" aria-label="Morzsamenü">
        <a href="/">Főoldal</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a>
      </nav>
      <div class="blog-masthead-panel">
        <div class="blog-masthead-copy">
          <a class="blog-masthead-category" href={categoryUrl(category)}>{category.name}</a>
          <h1 id="post-title" set:html={titleHtml(post.title)} />
          <p class="blog-masthead-deck">{post.excerpt}</p>
          <div class="blog-masthead-byline">
            <a href="#szerzo">{author.name}</a>
            <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
            <span>{rendered!.readingMinutes} perc olvasás</span>
          </div>
          {modified && <p class="blog-masthead-updated">Frissítve <time datetime={modified}>{formatDate(modified)}</time></p>}
        </div>
        <div class="blog-masthead-art">
          {cover
            ? <Fragment set:html={`<img ${imageAttrs(cover, { sizes: coverSizes, eager: true })}>`} />
            : <img src={artSrc(art)} alt="" width="410" height="236" decoding="async" />}
        </div>
      </div>
    </header>

    <div class="privacy-paper blog-paper">
      <div class="blog-paper-art" aria-hidden="true"><svg viewBox="0 0 1440 1400" fill="none" preserveAspectRatio="xMidYMin slice"><g stroke="#ff5c35" stroke-width="1.3"><path d="M1530 120C1380 150 1350 330 1470 420C1590 510 1560 690 1410 720" opacity=".26"/><path d="M1555 140C1405 170 1375 350 1495 440C1615 530 1585 710 1435 740" opacity=".12"/><path d="M-120 980C20 900 150 990 100 1120C50 1250 210 1340 330 1260" opacity=".24"/><path d="M-104 1004C36 924 166 1014 116 1144C66 1274 226 1364 346 1284" opacity=".11"/><path d="M60 250C150 210 200 280 160 350" opacity=".2"/></g><circle cx="1452" cy="1060" r="150" fill="#ff5c35" opacity=".04"/><circle cx="1452" cy="1060" r="196" stroke="#ff5c35" stroke-width="1" opacity=".1"/><rect x="1320" y="90" width="18" height="18" rx="4" transform="rotate(24 1320 90)" fill="#ff5c35" opacity=".16"/><g stroke="#ff5c35" stroke-width="1.3" opacity=".45"><path d="M86 560v14m-7-7h14M1360 640v14m-7-7h14"/></g></svg></div>
      <div class="wrap blog-layout">
        <aside class="blog-rail blog-rail-left" aria-label="A cikkről">
          {hasToc && (
            <details class="blog-mobile-toc">
              <summary>A cikkben</summary>
              <nav aria-label="Tartalomjegyzék">
                {rendered!.toc.map(e => <a href={'#' + e.id}>{e.text}</a>)}
              </nav>
            </details>
          )}
          <div class="blog-rail-sticky">
            {hasToc && (
              <nav class="privacy-toc blog-toc" aria-label="Tartalomjegyzék">
                <p class="eyebrow">A cikkben</p>
                <span class="blog-progress" aria-hidden="true"><i></i></span>
                {rendered!.toc.map(e => <a class={e.level === 3 ? 'toc-sub' : undefined} href={'#' + e.id}>{e.text}<span aria-hidden="true">·</span></a>)}
              </nav>
            )}
            <div class="blog-share">
              <p class="eyebrow">Megosztás</p>
              <nav class="blog-share-links" aria-label="Cikk megosztása">
                <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Megosztás Facebookon (új lapon)" title="Facebook">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.7 22v-9h3.05l.5-3.5H13.7V7.2c0-1.05.3-1.7 1.8-1.7h1.85V2.35A23 23 0 0 0 14.65 2C12 2 10.2 3.6 10.2 6.45V9.5H7V13h3.2v9h3.5Z"/></svg>
                </a>
                <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Megosztás LinkedInen (új lapon)" title="LinkedIn">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="5.6" cy="5.4" r="1.8"/><path d="M4 8.8h3.3V20H4zm5.8 0H13v1.55c.75-1.15 1.85-1.85 3.5-1.85 3.2 0 4.5 2 4.5 5.5v6h-3.3v-5.55c0-1.8-.35-3.05-2.05-3.05-1.75 0-2.55 1.2-2.55 3.2V20H9.8V8.8Z"/></svg>
                </a>
                <a href={`mailto:?subject=${encodeURIComponent(post.title)}&body=${shareUrl}`} aria-label="Megosztás e-mailben" title="E-mail">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                </a>
              </nav>
              <a class="blog-share-rss" href="/blog/rss.xml"><span>Új írások RSS-ben</span><span aria-hidden="true">+</span></a>
            </div>
          </div>
        </aside>

        <div class="blog-document" id="cikk">
          {cover && !cover.generated && (cover.caption || cover.credit) && <p class="blog-cover-credit">Borítókép: {[cover.caption, cover.credit].filter(Boolean).join(' · ')}</p>}
          <div class="post-prose" set:html={rendered!.html} />
          {post.sources.length > 0 && (
            <section class="post-sources" aria-labelledby="sources-title">
              <h2 id="sources-title">Források</h2>
              <ol>{post.sources.map(s => <li><a href={s.url} rel="noopener">{s.title}</a>{s.publisher && <span> — {s.publisher}</span>}</li>)}</ol>
            </section>
          )}
          <section class="post-author" id="szerzo" aria-labelledby="author-title">
            {photo
              ? <Fragment set:html={`<img class="post-author-photo" ${imageAttrs(photo, { sizes: '88px', eager: false })}>`} />
              : <span class="post-author-mark" aria-hidden="true">{author.name.split(/\s+/).map(w => w[0]).join('').slice(0, 2)}</span>}
            <div>
              <p class="eyebrow">A szerzőről</p>
              <h2 id="author-title">{author.name}</h2>
              {author.jobTitle && <p class="post-author-role">{author.jobTitle}</p>}
              {author.bio && <p>{author.bio}</p>}
              {author.sameAs.length > 0 && <p class="post-author-links">{author.sameAs.map(u => <a href={u} rel="noopener me">{new URL(u).hostname.replace(/^www\./, '')}</a>)}</p>}
            </div>
          </section>
        </div>

        <aside class="blog-rail blog-rail-right" aria-label="Kapcsolódó szolgáltatás és elérhetőség">
          <div class="blog-rail-sticky">
            <article class="capability-card blog-service-card">
              <div class="capability-art blog-service-art"><img src={artSrc(art)} alt="" width="410" height="236" loading="lazy" decoding="async" /></div>
              <div class="capability-copy">
                <p class="eyebrow">Ebben segíthetek</p>
                <h2><a href={sideService.path}>{sideService.label}</a></h2>
                <ul>{sideService.scope.slice(0, 3).map(item => <li>{item}</li>)}</ul>
                <a class="capability-cta" href={sideService.path}>Részletek<span aria-hidden="true">+</span></a>
              </div>
            </article>
            <div class="blog-contact">
              <p class="eyebrow">Kérdésed van?</p>
              <a class="blog-contact-email" href="mailto:info@vizitor.hu">info@vizitor.hu</a>
              <a class="blog-contact-phone" href="tel:+36205180921">+36 20 518 0921</a>
              <a class="blog-contact-cta" href="/kapcsolat/">Írok egy üzenetet<span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </aside>
      </div>

      {related.length > 0 && (
        <section class="wrap blog-related" aria-labelledby="related-title">
          <div class="blog-related-head"><p class="eyebrow">Olvasd tovább</p><h2 id="related-title">Kapcsolódó írások</h2></div>
          <div class="blog-related-grid">
            {related.map(p => {
              const c = coverOf(p);
              return (
                <article class="capability-card blog-related-card">
                  <div class="capability-art blog-related-art">{c ? <Fragment set:html={`<img ${imageAttrs(c, { sizes: '(min-width: 1000px) 380px, calc(100vw - 32px)', eager: false })}>`} /> : <img src={artSrc(artFor(p))} alt="" width="410" height="236" loading="lazy" decoding="async" />}</div>
                  <div class="capability-copy">
                    <p class="eyebrow">{categoryOf(p).name}</p>
                    <h3><a href={postUrl(p)}>{p.title}</a></h3>
                    <p>{p.excerpt}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}
    </div>

    <aside class="blog-article-cta" aria-labelledby="cta-title">
      <div class="wrap blog-article-cta-inner">
        <p class="eyebrow">{service ? 'Kapcsolódó szolgáltatás' : 'Beszéljük meg'}</p>
        <h2 id="cta-title">{service ? serviceLabels[service] : 'Van egy hasonló feladatod?'}</h2>
        <p class="blog-article-cta-text">{service ? 'Ha a cikk témája nálad is aktuális, nézd meg, hogyan dolgozom, vagy írd meg röviden, mire van szükséged.' : 'Írd meg röviden, mire van szükséged. Közvetlenül velem egyeztetsz, és még a munka előtt tudni fogod a díjat és a határidőt.'}</p>
        <div class="blog-article-cta-actions">
          <a class="button orange" href="/kapcsolat/">Ajánlatot kérek</a>
          {service && <a class="text-link" href={service}>{serviceLabels[service]} részletei</a>}
        </div>
      </div>
    </aside>
  </article>
</BlogLayout>
)}
