# Copy to .env on the server (chmod 600). Never commit the real file.
# --- Database (used by docker-compose for both containers)
POSTGRES_DB=vizitor_cms
POSTGRES_USER=vizitor_cms
POSTGRES_PASSWORD=change-me-long-random
# --- Payload
PAYLOAD_SECRET=change-me-64-random-chars
PAYLOAD_PUBLIC_SERVER_URL=https://cms.vizitor.hu
# Host port on 127.0.0.1 (must be free on the server)
CMS_PORT=3010
# --- Publishing
# Vercel → Project → Settings → Git → Deploy Hooks (branch: main)
VERCEL_DEPLOY_HOOK_URL=
# Used to confirm that a build is live (reads /blog/build-info.json)
PUBLIC_SITE_URL=https://vizitor.hu
# Same value as BLOG_EXPORT_TOKEN in the Vercel project's environment variables
BLOG_EXPORT_TOKEN=change-me-random
# --- Optional
# DEPLOY_QUIET_MS=4000
# CSRF_ORIGINS=https://cms.vizitor.hu
