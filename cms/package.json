{
  "name": "vizitor-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Vizitor blog CMS (Payload). Runs on the VPS; not part of the Vercel deployment.",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3010",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=3072\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port ${PORT:-3010}",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.2",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/richtext-lexical": "3.94.2",
    "@payloadcms/ui": "3.94.2",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.4.6",
    "payload": "3.94.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3"
  }
}
